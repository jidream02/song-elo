# Telegram: токен от @BotFather
BOT_TOKEN=123456:ABC...

# Spotify: https://developer.spotify.com/dashboard → Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Gemini (бесплатный тариф): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Claude API (необязательно, платно): https://console.anthropic.com → API Keys. Пусто — ИИ-оценка выключена
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LLM_MIN_CONFIDENCE=0.4

# Антинакрутка
BATTLES_PER_MINUTE=10
RATES_PER_MINUTE=5

# Postgres (в Docker Compose DATABASE_URL собирается автоматически из этих трёх)
POSTGRES_USER=songelo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=songelo

# Только для запуска без Docker:
DATABASE_URL=postgresql+asyncpg://songelo:change-me@localhost:5432/songelo
